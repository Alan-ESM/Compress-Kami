<Window x:Class="Compress_Kami.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compress-Kami" 
        Height="550" Width="750"
        MinHeight="500" MinWidth="650"
        Background="#0A0A15"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style x:Key="KamiButton" TargetType="Button">
            <Setter Property="Background" Value="#A020F0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="25,12"/>
            <Setter Property="Margin" Value="15"/>
            <Setter Property="Height" Value="65"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="#E040FF"
                                BorderThickness="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#C050FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#7A00CC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ScrollViewer pour pouvoir scroller si la fenêtre est trop petite -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="120"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="80"/>
            </Grid.RowDefinitions>

            <!-- Titre -->
            <TextBlock Text="Compress-Kami"
                       FontSize="48"
                       FontWeight="ExtraBold"
                       Foreground="#E6B8FF"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,25,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#A020F0" BlurRadius="20" ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock Text="Format propriétaire .keyce — Groupe 5"
                       FontSize="18"
                       Foreground="#D896FF"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,85,0,0"/>

            <!-- Tous les boutons dans un StackPanel scrollable -->
            <StackPanel Grid.Row="2" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Top"
                        Width="500"
                        Margin="0,20,0,30">

                <Button Content="Compresser en .keyce"
                        Style="{StaticResource KamiButton}"
                        Click="CompressKeyce_Click"/>

                <Button Content="Décompresser un .keyce"
                        Style="{StaticResource KamiButton}"
                        Click="DecompressKeyce_Click"/>

                <Button Content="Zipper en .ZIP"
                        Style="{StaticResource KamiButton}"
                        Click="CompressZip_Click"/>

                <Button Content="Dézipper un .ZIP"
                        Style="{StaticResource KamiButton}"
                        Click="DecompressZip_Click"/>

                <ProgressBar x:Name="ProgressBar"
                             Height="18"
                             Margin="40,30,40,15"
                             Foreground="#A020F0"
                             Background="#1E1E2D"
                             BorderBrush="#7A00CC"
                             BorderThickness="2"
                             IsIndeterminate="True"
                             Visibility="Collapsed"/>

                <TextBlock x:Name="StatusText"
                           Text="Prêt à créer des fichiers .keyce ultimes"
                           Foreground="#E6B8FF"
                           FontSize="20"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           Margin="15,8"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Footer fixe en bas -->
            <Border Grid.Row="3" Background="#14141F" BorderBrush="#7A00CC" BorderThickness="0,2,0,0">
                <TextBlock Text="© 2025 Compress-Kami — Format .keyce propriétaire • Groupe 5"
                           Foreground="#A078FF"
                           FontSize="14"
                           FontWeight="Medium"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>